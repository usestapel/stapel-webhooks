{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webhooks.delivery.succeeded",
  "description": "A reaction was delivered to its subscriber. Ids and the attempt count only — the delivered payload does not ride this topic.",
  "type": "object",
  "required": ["delivery_id", "subscription_id", "event_type", "attempts"],
  "properties": {
    "delivery_id": {"type": "string", "format": "uuid"},
    "subscription_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string"},
    "event_id": {"type": "string"},
    "attempts": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
