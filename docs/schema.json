  "paths": {
    "/webhooks/api/v1/deliveries/{delivery_id}": {
      "get": {
        "operationId": "webhooks_api_v1_deliveries_retrieve",
        "description": "One delivery record, payload included — what a replay would send.\n\n**Permissions:** `HasWorkspaceMandateIfScoped`",
        "parameters": [
          {
            "in": "path",
            "name": "delivery_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "Webhooks"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryPresenterDTO"
                },
                "examples": {
                  "DeliveryPresenterDTO": {
                    "value": {
                      "id": "9aa1c0de-0000-4000-8000-000000000001",
                      "subscription_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "event_type": "listing.published",
                      "event_id": "b0c1...",
                      "status": "retrying",
                      "attempts": 2,
                      "response_status": 503,
                      "last_error": "Service Unavailable",
                      "next_attempt_at": "2026-08-24T10:05:00+00:00",
                      "last_attempt_at": "2026-08-24T10:00:00+00:00",
                      "completed_at": null,
                      "created_at": "2026-08-24T09:59:00+00:00"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
