    "/webhooks/api/v1/subscriptions/{subscription_id}/secret": {
      "post": {
        "operationId": "webhooks_api_v1_subscriptions_secret_create",
        "description": "Rotate the signing secret and hand back the new one.\n\n**Permissions:** `HasWorkspaceMandateIfScoped`",
        "parameters": [
          {
            "in": "path",
            "name": "subscription_id",
            "schema": {
