        "parameters": [
          {
            "in": "query",
            "name": "event_type",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "is_active",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "tags": [
          "Webhooks"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SubscriptionPresenterDTO"
                  }
                },
                "examples": {
                  "SubscriptionPresenterDTO": {
                    "value": [
                      {
                        "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                        "event_type": "listing.published",
                        "delivery": "webhook",
                        "target": {
                          "url": "https://example.com/hooks/stapel"
                        },
                        "filter": {
                          "city": "berlin"
                        },
                        "description": "CRM sync",
                        "is_active": true,
                        "has_secret": true,
                        "consecutive_failures": 0,
                        "disabled_at": null,
                        "last_delivery_at": "2026-08-24T10:00:00+00:00",
                        "owner_id": "5cc26b64-0717-4562-b3fc-2c963f66a001",
                        "workspace_id": null,
                        "created_at": "2026-08-20T09:00:00+00:00",
                        "updated_at": "2026-08-24T10:00:00+00:00"
                      }
                    ]
                  }
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "webhooks_api_v1_subscriptions_create",
        "description": "List the caller's reaction rules, or write a new one.\n\n**Permissions:** `HasWorkspaceMandateIfScoped`",
        "tags": [
          "Webhooks"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionCreate"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionCreate"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionCreate"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionSecretDTO"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
