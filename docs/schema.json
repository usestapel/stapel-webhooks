  },
  "components": {
    "schemas": {
      "CatalogEventDTO": {
        "type": "object",
        "description": "One subscribable event, as the subscription builder needs it.",
        "properties": {
          "event": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "description",
          "event",
          "module",
          "package"
        ]
      },
      "DeliveryPresenterDTO": {
        "type": "object",
        "description": "Presents one delivery attempt record.",
        "properties": {
          "event_type": {
            "type": "string",
            "description": "event type"
          },
          "event_id": {
            "type": "string",
            "description": "event id"
          },
          "status": {
            "type": "string",
            "description": "status"
          },
          "attempts": {
            "type": "integer",
            "description": "attempts"
          },
          "response_status": {
            "type": "integer",
            "description": "response status"
          },
          "last_error": {
            "type": "string",
            "description": "last error"
          },
          "id": {
            "type": "string"
          },
          "subscription_id": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": {},
            "description": "The event payload as it was matched — what a replay would send."
          },
          "next_attempt_at": {
            "type": "string",
            "nullable": true
          },
          "last_attempt_at": {
            "type": "string",
            "nullable": true
          },
          "completed_at": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "attempts",
          "event_id",
          "event_type",
          "id",
          "last_error",
          "payload",
          "response_status",
          "status",
          "subscription_id"
        ]
      },
      "EventCatalogDTO": {
        "type": "object",
        "description": "Everything this deployment can react to, generated from installed\npackages' ``schemas/emits/`` — never a hand-kept list.",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogEventDTO"
            }
          },
          "delivery_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PatchedSubscriptionPatch": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 128
          },
          "delivery": {
            "type": "string",
            "maxLength": 32
          },
          "target": {
            "type": "object",
            "additionalProperties": {}
          },
          "filter": {},
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "ReplayResultDTO": {
        "type": "object",
        "description": "What a replay did: the row is queued again, from attempt zero.",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "next_attempt_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "SubscriptionCreate": {
        "type": "object",
        "description": "The reaction rule, as a client writes it.\n\n``filter`` keeps the design document's name on the wire even though the\ncolumn is ``payload_filter``: the API is where the vocabulary of the\nfeature lives, and \"filter\" is what it is called everywhere else.",
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 128
          },
          "delivery": {
            "type": "string",
            "maxLength": 32
          },
          "target": {
            "type": "object",
            "additionalProperties": {}
          },
          "filter": {},
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "delivery",
          "event_type",
          "target"
        ]
      },
      "SubscriptionPresenterDTO": {
        "type": "object",
        "description": "Presents a reaction rule to its owner.",
        "properties": {
          "event_type": {
            "type": "string",
            "description": "event type"
          },
          "delivery": {
            "type": "string",
            "description": "delivery"
          },
          "description": {
            "type": "string",
            "description": "description"
          },
          "is_active": {
            "type": "boolean",
            "description": "is active"
          },
          "consecutive_failures": {
            "type": "integer",
            "description": "consecutive failures"
          },
          "id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "additionalProperties": {},
            "description": "Delivery-type-specific destination."
          },
          "filter": {
            "type": "object",
            "additionalProperties": {},
            "description": "JSON predicate over the event payload; {} matches every event."
          },
          "has_secret": {
            "type": "boolean",
            "description": "Whether a signing secret exists. The secret itself is only ever returned by create and rotate."
          },
          "owner_id": {
            "type": "string",
            "nullable": true
          },
          "workspace_id": {
            "type": "string",
            "nullable": true
          },
          "disabled_at": {
            "type": "string",
            "nullable": true
          },
          "last_delivery_at": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "consecutive_failures",
          "delivery",
          "description",
          "event_type",
          "filter",
          "has_secret",
          "id",
          "is_active",
          "target"
        ]
      },
      "SubscriptionSecretDTO": {
        "type": "object",
        "description": "The one and only time a signing secret is readable.\n\nReturned by create and by rotate, never by a read. A secret that can be\nfetched again is a secret whose leak has no expiry — the receiver stores\nit on first sight, exactly like an API key.",
        "properties": {
          "id": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "secret"
        ]
      }
    },
    "securitySchemes": {
      "JWTCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stapel_jwt",
        "description": "JWT token stored in cookie. Login via /auth/admin/ to get the cookie."
      }
    }
  }
}
