          }
        }
      }
    },
    "/webhooks/api/v1/event-catalog": {
      "get": {
        "operationId": "webhooks_api_v1_event_catalog_retrieve",
        "description": "What this deployment can react to, and how it can deliver.\n\nGenerated from installed packages' ``schemas/emits/`` on every call\n(the scan is cached per process), so the subscription builder is never\na mirror of a list somebody maintains.\n\n**Permissions:** `HasWorkspaceMandateIfScoped`",
        "tags": [
          "Webhooks"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCatalogDTO"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/webhooks/api/v1/subscriptions": {
      "get": {
        "operationId": "webhooks_api_v1_subscriptions_list",
